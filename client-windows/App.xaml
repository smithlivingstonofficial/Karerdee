<Application x:Class="SafeExamClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Light Theme Academic Styles -->
        <SolidColorBrush x:Key="CanvasBackground" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SurfaceCard" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#E2E8F0" />
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondary" Color="#475569" />
        <SolidColorBrush x:Key="PrimaryBlue" Color="#1D4ED8" />
    </Application.Resources>
</Application>

